{
  "name": "demoSales",
  "systemType": "crm",
  "description": "Local fixture connector for reading demo sales records.",
  "protocol": "file",
  "auth": {
    "type": "none",
    "scopes": []
  },
  "permissions": [
    {
      "name": "readSales",
      "riskLevel": "low",
      "requiresApproval": false
    },
    {
      "name": "writeSales",
      "riskLevel": "medium",
      "requiresApproval": true
    }
  ],
  "endpoints": [
    {
      "operationId": "readSales",
      "method": "GET",
      "path": "/sales",
      "description": "Read local demo sales records.",
      "permission": "readSales",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "customer": { "type": "string" },
            "amount": { "type": "number" },
            "status": { "type": "string" }
          }
        }
      },
      "dataClassifications": ["public"]
    },
    {
      "operationId": "createSale",
      "method": "POST",
      "path": "/sales",
      "description": "Draft a local demo sales record.",
      "permission": "writeSales",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customer": { "type": "string" },
          "amount": { "type": "number" }
        },
        "required": ["customer", "amount"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "customer": { "type": "string" },
          "amount": { "type": "number" },
          "status": { "type": "string" }
        }
      },
      "dataClassifications": ["public"]
    }
  ],
  "dataClassifications": ["public"],
  "rateLimits": {
    "callsPerMinute": 60
  },
  "costOwner": "free",
  "fixtureMode": true,
  "fixtureData": "../../docs/demoData/sales.json",
  "readWrite": {
    "read": ["readSales"],
    "write": ["createSale"]
  }
}
